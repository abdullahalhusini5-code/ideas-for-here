{
  "name": "ideas-for-here",
  "version": "1.0.0",
  "private": true,
  "description": "A plain-English catalog of small local app ideas, with a zero-dependency MCP server.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "node server.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:readonly": "node mcp/server.mjs --read-only",
    "test": "node tools/test-mcp.mjs",
    "test:data": "node tools/test-mcp.mjs --data-only",
    "check:schema": "node tools/check-schema.mjs",
    "check:repo": "node tools/check-repo.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:html": "html-validate \"*.html\"",
    "check:links": "node tools/check-links.js",
    "verify": "node tools/test-mcp.mjs && node tools/check-schema.mjs && node tools/check-repo.mjs && node tools/check-contrast.mjs && npm run check:html"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "html-validate": "10.17.0"
  }
}
